<?xml version='1.0' encoding='UTF-8'?>
<LanguageData>
  <!-- Mending -->
  <!--原中文: '修补', 原英文: '无' -> 新英文: 'Mending',更新于2026-02-14-->
  <!--EN: Mending-->
  <TM_ArtifactMendingHD.label>修补</TM_ArtifactMendingHD.label>
  <!--原中文: '修理身上的服装和武器。', 原英文: '无' -> 新英文: 'Mends and repairs equipped apparel and weapons.',更新于2026-02-14-->
  <!--EN: Mends and repairs equipped apparel and weapons.-->
  <TM_ArtifactMendingHD.description>修理身上的服装和武器。</TM_ArtifactMendingHD.description>
  <!-- Health Charm -->
  <!--原中文: '改善健康', 原英文: '无' -> 新英文: 'Improved Health',更新于2026-02-14-->
  <!--EN: Improved Health-->
  <TM_ArtifactHealthHD.label>改善健康</TM_ArtifactHealthHD.label>
  <!--原中文: '增加自然愈合效果.', 原英文: '无' -> 新英文: 'Increases natural healing.',更新于2026-02-14-->
  <!--EN: Increases natural healing.-->
  <TM_ArtifactHealthHD.description>增加自然愈合效果.</TM_ArtifactHealthHD.description>
  <!-- Cat Eyes -->
  <!--原中文: '黑暗的视线', 原英文: '无' -> 新英文: 'Dark Sight',更新于2026-02-14-->
  <!--EN: Dark Sight-->
  <TM_ArtifactCatEyesHD.label>黑暗的视线</TM_ArtifactCatEyesHD.label>
  <!--原中文: '改善视力并提供轻微的夜视.', 原英文: '无' -> 新英文: 'Improves sight and grants minor night vision.',更新于2026-02-14-->
  <!--EN: Improves sight and grants minor night vision.-->
  <TM_ArtifactCatEyesHD.description>改善视力并提供轻微的夜视.</TM_ArtifactCatEyesHD.description>
  <!-- Strength of Stone -->
  <!--原中文: '石之力量', 原英文: '无' -> 新英文: 'Strength of Stone',更新于2026-02-14-->
  <!--EN: Strength of Stone-->
  <TM_ArtifactStrengthHD.label>石之力量</TM_ArtifactStrengthHD.label>
  <!--原中文: '增加力量的魔法。', 原英文: '无' -> 新英文: 'An enchantment that increases manipulation.',更新于2026-02-14-->
  <!--EN: An enchantment that increases manipulation.-->
  <TM_ArtifactStrengthHD.description>增加力量的魔法。</TM_ArtifactStrengthHD.description>
  <!-- Mind Ward -->
  <!--原中文: '精神守护', 原英文: '无' -> 新英文: 'Mind Ward',更新于2026-02-14-->
  <!--EN: Mind Ward-->
  <TM_ArtifactMindHD.label>精神守护</TM_ArtifactMindHD.label>
  <!--原中文: '一种独特的护身魔法，可以帮助人们将他们的情绪分隔开来，以便从精神崩溃中迅速恢复。', 原英文: '无' -> 新英文: 'A unique talisman that helps a pawn compartmentalize their emotions to quickly recover from a mental breakdown.',更新于2026-02-14-->
  <!--EN: A unique talisman that helps a pawn compartmentalize their emotions to quickly recover from a mental breakdown.-->
  <TM_ArtifactMindHD.description>一种独特的护身魔法，可以帮助人们将他们的情绪分隔开来，以便从精神崩溃中迅速恢复。</TM_ArtifactMindHD.description>
  <!-- Renewal -->
  <!--原中文: '重生', 原英文: '无' -> 新英文: 'Renewal',更新于2026-02-14-->
  <!--EN: Renewal-->
  <TM_ArtifactRenewalHD.label>重生</TM_ArtifactRenewalHD.label>
  <!--原中文: '提高睡眠质量.', 原英文: '无' -> 新英文: 'Improves the quality of sleep.',更新于2026-02-14-->
  <!--EN: Improves the quality of sleep.-->
  <TM_ArtifactRenewalHD.description>提高睡眠质量.</TM_ArtifactRenewalHD.description>
  <!-- Arcane Recovery -->
  <!--原中文: '神秘复苏', 原英文: '无' -> 新英文: 'Arcane Recovery',更新于2026-02-14-->
  <!--EN: Arcane Recovery-->
  <TM_ArtifactArcaneRecoveryHD.label>神秘复苏</TM_ArtifactArcaneRecoveryHD.label>
  <!--原中文: '增加从奥术虚弱中恢复的速度；不减少获得的奥术虚弱的严重性.', 原英文: '无' -> 新英文: 'Increases the recovery rate from Arcane Weakness; does not reduce the amount of Arcane Weakness acquired.',更新于2026-02-14-->
  <!--EN: Increases the recovery rate from Arcane Weakness; does not reduce the amount of Arcane Weakness acquired.-->
  <TM_ArtifactArcaneRecoveryHD.description>增加从奥术虚弱中恢复的速度；不减少获得的奥术虚弱的严重性.</TM_ArtifactArcaneRecoveryHD.description>
  <!-- Pathfinding -->
  <!--原中文: '寻路', 原英文: '无' -> 新英文: 'Pathfinding',更新于2026-02-14-->
  <!--EN: Pathfinding-->
  <TM_ArtifactPathfindingHD.label>寻路</TM_ArtifactPathfindingHD.label>
  <!--原中文: '一种护身魔法，能神奇地确定一条容易通过任何障碍物的路径；减少通过障碍物和地形的移动速度惩罚.', 原英文: '无' -> 新英文: 'A talisman that uncannily ascertains an easy path across any obstacle; bypasses the movement penalty for obstacles and terrain.',更新于2026-02-14-->
  <!--EN: A talisman that uncannily ascertains an easy path across any obstacle; bypasses the movement penalty for obstacles and terrain.-->
  <TM_ArtifactPathfindingHD.description>一种护身魔法，能神奇地确定一条容易通过任何障碍物的路径；减少通过障碍物和地形的移动速度惩罚.</TM_ArtifactPathfindingHD.description>
  <!-- Defensive Bracers -->
  <!--原中文: '阻挡', 原英文: '无' -> 新英文: 'Blocking',更新于2026-02-14-->
  <!--EN: Blocking-->
  <TM_ArtifactBlockHD.label>阻挡</TM_ArtifactBlockHD.label>
  <!--原中文: '阻止物理攻击；不会受到被成功阻止的攻击造成的伤害。', 原英文: '无' -> 新英文: 'Blocks physical attacks; prevents damage from successfully blocked attacks.',更新于2026-02-14-->
  <!--EN: Blocks physical attacks; prevents damage from successfully blocked attacks.-->
  <TM_ArtifactBlockHD.description>阻止物理攻击；不会受到被成功阻止的攻击造成的伤害。</TM_ArtifactBlockHD.description>
  <!--原中文: '偏移阻挡', 原英文: '无' -> 新英文: 'Deflective Blocking',更新于2026-02-14-->
  <!--EN: Deflective Blocking-->
  <TM_ArtifactDeflectHD.label>偏移阻挡</TM_ArtifactDeflectHD.label>
  <!--原中文: '阻挡攻击并能将子弹偏转到附近的敌人；不会受到被成功偏转的攻击造成的伤害.', 原英文: '无' -> 新英文: 'Blocks attacks and can deflect projectiles to nearby enemies; prevents damage from a successfully deflected attack.',更新于2026-02-14-->
  <!--EN: Blocks attacks and can deflect projectiles to nearby enemies; prevents damage from a successfully deflected attack.-->
  <TM_ArtifactDeflectHD.description>阻挡攻击并能将子弹偏转到附近的敌人；不会受到被成功偏转的攻击造成的伤害.</TM_ArtifactDeflectHD.description>
  <!-- Energy Pool Boosts -->
  <!--原中文: '血液循环', 原英文: '无' -> 新英文: 'Blood Boost',更新于2026-02-14-->
  <!--EN: Blood Boost-->
  <TM_Artifact_BloodBoostHD.label>血液循环</TM_Artifact_BloodBoostHD.label>
  <!--原中文: '增加血法师的最多血法力上限。', 原英文: '无' -> 新英文: 'Increases the maximum blood magic available to a blood mage.',更新于2026-02-14-->
  <!--EN: Increases the maximum blood magic available to a blood mage.-->
  <TM_Artifact_BloodBoostHD.description>增加血法师的最多血法力上限。</TM_Artifact_BloodBoostHD.description>
  <!--原中文: '心灵刺激', 原英文: '无' -> 新英文: 'Psionic Boost',更新于2026-02-14-->
  <!--EN: Psionic Boost-->
  <TM_Artifact_PsionicBoostHD.label>心灵刺激</TM_Artifact_PsionicBoostHD.label>
  <!--原中文: '增加灵能战斗的最多灵能上限.', 原英文: '无' -> 新英文: 'Increases the maximum psionic energy available to a psionic.',更新于2026-02-14-->
  <!--EN: Increases the maximum psionic energy available to a psionic.-->
  <TM_Artifact_PsionicBoostHD.description>增加灵能战斗的最多灵能上限.</TM_Artifact_PsionicBoostHD.description>
  <!--原中文: '仇恨提升', 原英文: '无' -> 新英文: 'Hate Boost',更新于2026-02-14-->
  <!--EN: Hate Boost-->
  <TM_Artifact_HateBoostHD.label>仇恨提升</TM_Artifact_HateBoostHD.label>
  <!--原中文: '增加死亡骑士的仇恨上限。', 原英文: '无' -> 新英文: 'Increases the maximum hate available to a death knight.',更新于2026-02-14-->
  <!--EN: Increases the maximum hate available to a death knight.-->
  <TM_Artifact_HateBoostHD.description>增加死亡骑士的仇恨上限。</TM_Artifact_HateBoostHD.description>
  <!-- soul orb infusion debuff -->
  <!--原中文: '注入特性', 原英文: '无' -> 新英文: 'Trait Infusion',更新于2026-02-14-->
  <!--EN: Trait Infusion-->
  <TM_TraitInfusionHD.label>注入特性</TM_TraitInfusionHD.label>
  <!--原中文: '一个小人通过魔法注入获得了一些特质，这会影响他们的自我意识.', 原英文: '无' -> 新英文: 'A pawn has gained traits through magical infusion; this will affect their sense of self.',更新于2026-02-14-->
  <!--EN: A pawn has gained traits through magical infusion; this will affect their sense of self.-->
  <TM_TraitInfusionHD.description>一个小人通过魔法注入获得了一些特质，这会影响他们的自我意识.</TM_TraitInfusionHD.description>
  <!-- Winter's Staff -->
  <!--原中文: '寒气', 原英文: '无' -> 新英文: 'Winter's Chill',更新于2026-02-14-->
  <!--EN: Winter's Chill-->
  <TM_WinterStaffHD.label>寒气</TM_WinterStaffHD.label>
  <!--原中文: '排出身体的热量和能量，可以防止中暑。魔法师使用时，可降低室内温度。', 原英文: '无' -> 新英文: 'Drains heat and energy from the body; prevents heat stroke. Mages only: lowers room temperature.',更新于2026-02-14-->
  <!--EN: Drains heat and energy from the body; prevents heat stroke. Mages only: lowers room temperature.-->
  <TM_WinterStaffHD.description>排出身体的热量和能量，可以防止中暑。魔法师使用时，可降低室内温度。</TM_WinterStaffHD.description>
  <!-- Shroud of Undead (Shroud of Soulreaper buff) -->
  <!--原中文: '亡灵裹尸布', 原英文: '无' -> 新英文: 'Shroud of Undeath',更新于2026-02-14-->
  <!--EN: Shroud of Undeath-->
  <TM_ShroudOfUndeathHD.label>亡灵裹尸布</TM_ShroudOfUndeathHD.label>
  <!--原中文: '减少此死灵法师对亡灵的维持费用并增加附近亡灵的移动力和攻击力。', 原英文: '无' -> 新英文: 'Reduces undead upkeep of this necromancer and increases the movement and attack power of nearby undead.',更新于2026-02-14-->
  <!--EN: Reduces undead upkeep of this necromancer and increases the movement and attack power of nearby undead.-->
  <TM_ShroudOfUndeathHD.description>减少此死灵法师对亡灵的维持费用并增加附近亡灵的移动力和攻击力。</TM_ShroudOfUndeathHD.description>
</LanguageData>
