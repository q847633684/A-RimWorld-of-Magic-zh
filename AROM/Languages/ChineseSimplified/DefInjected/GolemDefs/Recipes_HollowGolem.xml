  <!--EN: crafting golem part-->
  <TM_HollowGolem_FlamesOfDevouringApathy.jobString>制造傀儡部位</TM_HollowGolem_FlamesOfDevouringApathy.jobString>
  <!--EN: Flames of Devouring Apathy-->
  <TM_HollowGolem_FlamesOfDevouringApathy.label>吞噬冷漠之火</TM_HollowGolem_FlamesOfDevouringApathy.label>
  <!--EN: Increases armor of the golem by protecting the head:
Blunt:	+26%
Sharp:	+9%
Heat:	+11%
Hit:	+15%-->
