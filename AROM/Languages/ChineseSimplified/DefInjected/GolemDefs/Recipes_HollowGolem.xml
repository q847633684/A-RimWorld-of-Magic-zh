  <!--EN: crafting golem part-->
  <TM_HollowGolem_OrbOfExtinguishedFlames.jobString>制造傀儡部位</TM_HollowGolem_OrbOfExtinguishedFlames.jobString>
  <!--EN: Orb of Extinguished Flames-->
  <TM_HollowGolem_OrbOfExtinguishedFlames.label>熄灭火焰之球</TM_HollowGolem_OrbOfExtinguishedFlames.label>
